#!/bin/sh
# Blocks commits that would leak secrets. Install: git config core.hooksPath scripts/hooks
fail=0
if git diff --cached --name-only | grep -qE '(^|/)\.env$'; then
  echo "pre-commit: refusing to commit .env" >&2; fail=1
fi
if [ -f .env ]; then
  # Check every non-empty *_KEY value from .env against the staged diff (values never printed).
  grep -E '^[A-Z_]*KEY=.+' .env | cut -d= -f2- | tr -d '\r"'"'" | while IFS= read -r val; do
    [ ${#val} -ge 8 ] || continue
    if git diff --cached -U0 | grep -qF -- "$val"; then
      echo "pre-commit: a secret value from .env appears in the staged changes" >&2; exit 1
    fi
  done || fail=1
fi
exit $fail
