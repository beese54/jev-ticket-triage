#!/bin/sh
# Blocks commits that would leak secrets. Install: git config core.hooksPath scripts/hooks
if git diff --cached --name-only | grep -qE '(^|/)\.env$'; then
  echo "pre-commit: refusing to commit .env" >&2; exit 1
fi
[ -f .env ] || exit 0

# Every *_KEY value from .env with >= 8 chars, as fixed-string patterns (never printed).
# Scratch files live inside .git/ (never committed) and are removed on exit.
gitdir=$(git rev-parse --git-dir)
patterns="$gitdir/secret-patterns.$$"
staged="$gitdir/secret-scan.$$"
trap 'rm -rf "$patterns" "$staged"' EXIT
grep -E '^[A-Z_]*KEY=.+' .env | cut -d= -f2- | tr -d '\r"'"'" | awk 'length >= 8' > "$patterns"
[ -s "$patterns" ] || exit 0

if git diff --cached -U0 | grep -qF -f "$patterns"; then
  echo "pre-commit: a secret value from .env appears in the staged changes" >&2; exit 1
fi
# git diff shows gzip files as binary, so export the staged .gz blobs in one command
# and scan them decompressed in a single pass.
if git diff --cached --name-only --diff-filter=AM -z -- '*.gz' | grep -qz .; then
  mkdir -p "$staged"
  git diff --cached --name-only --diff-filter=AM -z -- '*.gz' \
    | git checkout-index -z --stdin --prefix="$staged/"
  if find "$staged" -type f -name '*.gz' -print0 | xargs -0 gzip -dc 2>/dev/null | grep -qF -f "$patterns"; then
    echo "pre-commit: a secret value from .env appears inside a staged .gz file" >&2; exit 1
  fi
fi
exit 0
