#!/bin/sh
# Blocks commits that would leak secrets. Install: git config core.hooksPath scripts/hooks
if git diff --cached --name-only | grep -qE '(^|/)\.env$'; then
  echo "pre-commit: refusing to commit .env" >&2; exit 1
fi
[ -f .env ] || exit 0

# Every *_KEY value from .env with >= 8 chars, as fixed-string patterns (never printed).
# The patterns file lives inside .git/ (never committed) and is removed on exit.
patterns="$(git rev-parse --git-dir)/secret-patterns.$$"
trap 'rm -f "$patterns"' EXIT
grep -E '^[A-Z_]*KEY=.+' .env | cut -d= -f2- | tr -d '\r"'"'" | awk 'length >= 8' > "$patterns"
[ -s "$patterns" ] || exit 0

if git diff --cached -U0 | grep -qF -f "$patterns"; then
  echo "pre-commit: a secret value from .env appears in the staged changes" >&2; exit 1
fi
# git diff shows gzip files as binary, so check the staged .gz blobs decompressed.
for f in $(git diff --cached --name-only --diff-filter=AM -- '*.gz'); do
  if git show ":$f" | gzip -dc 2>/dev/null | grep -qF -f "$patterns"; then
    echo "pre-commit: a secret value from .env appears inside $f" >&2; exit 1
  fi
done
exit 0
